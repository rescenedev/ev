#!/usr/bin/env zsh
# ev — Everything 스타일 TUI 검색 (rg + fzf + fd)
# 파일명(fd)과 내용(rg)을 한 번에 검색해 결과를 합쳐 보여준다.
set -euo pipefail

EV_HOME="${0:A:h}"
source "$EV_HOME/lib/deps.sh"
source "$EV_HOME/lib/editor.sh"
source "$EV_HOME/lib/preview.sh"
source "$EV_HOME/lib/search.sh"
source "$EV_HOME/lib/extract.sh"
source "$EV_HOME/lib/export.sh"
source "$EV_HOME/lib/visual.sh"

EV_EXTRACTOR="$EV_HOME/libexec/ev-extract"   # rg --pre / 미리보기용 텍스트 추출기
EV_EXPORT_DIR="${EV_EXPORT_DIR:-$HOME}"       # export/zip 저장 위치
EV_CLIP="${EV_CLIP:-pbcopy}"                  # 클립보드 명령 (테스트에서 override)

# ── 상태 헬퍼 ────────────────────────────────────────────────
_ev_hidden() { cat "$EV_STATE/hidden"; }
_ev_scope()  { cat "$EV_STATE/scope"; }   # both | files | content
_ev_visual() { cat "$EV_STATE/visual"; }  # 0 | 1 (인라인 이미지 미리보기)

# ── 서브커맨드 ───────────────────────────────────────────────
_ev_init() {
  printf '0\n'    > "$EV_STATE/hidden"
  printf 'both\n' > "$EV_STATE/scope"
  printf '0\n'    > "$EV_STATE/visual"
}

_ev_run_argv() {            # stdin: 토큰(줄당 1개) → 실행
  local cmd=()
  local tok
  while IFS= read -r tok; do cmd+=("$tok"); done
  [ "${#cmd[@]}" -eq 0 ] && return 0
  "${cmd[@]}"
}

# 검색: scope에 따라 파일명(fd) / 내용(rg) / 둘 다. 빈 쿼리면 파일 목록.
_ev_search() {
  local rawq="${FZF_QUERY:-}"
  local hidden scope q
  hidden="$(_ev_hidden)"
  scope="$(_ev_scope)"
  # '*.확장자' 토큰은 확장자 필터로, 나머지는 실제 검색어로 분리
  export EV_EXTS="$(ev_query_exts "$rawq")"
  q="$(ev_query_terms "$rawq")"
  if [ -z "$q" ]; then
    # 검색어 없음: content 전용은 결과 없음(단 확장자만 줬으면 파일 목록은 보여줌)
    if [ "$scope" = content ] && [ -z "$EV_EXTS" ]; then unset EV_EXTS; return 0; fi
    ev_fd_cmd "$EV_ROOT" "$hidden" | _ev_run_argv || true
    unset EV_EXTS; return 0
  fi
  case "$scope" in
    files)   ev_fd_cmd "$EV_ROOT" "$hidden" "$q" | _ev_run_argv || true ;;
    content) ev_rg_cmd "$EV_ROOT" "$hidden" "$q" "$EV_EXTRACTOR" | _ev_run_argv || true ;;
    *)       ev_fd_cmd "$EV_ROOT" "$hidden" "$q" | _ev_run_argv || true                  # 파일명
             ev_rg_cmd "$EV_ROOT" "$hidden" "$q" "$EV_EXTRACTOR" | _ev_run_argv || true ;; # 내용(hwpx 포함)
  esac
  unset EV_EXTS
}

# 검색 범위 순환: both → files → content → both. 프롬프트 라벨도 바꾼다.
_ev_cycle_scope() {
  local self="$EV_HOME/ev"
  case "$(_ev_scope)" in
    both)    printf 'files\n'   > "$EV_STATE/scope"; printf 'change-prompt(name> )+reload(%s __search)'   "$self" ;;
    files)   printf 'content\n' > "$EV_STATE/scope"; printf 'change-prompt(text> )+reload(%s __search)'   "$self" ;;
    *)       printf 'both\n'    > "$EV_STATE/scope"; printf 'change-prompt(search> )+reload(%s __search)' "$self" ;;
  esac
}

_ev_toggle_hidden() {
  if [ "$(_ev_hidden)" = 0 ]; then printf '1\n' > "$EV_STATE/hidden"
  else printf '0\n' > "$EV_STATE/hidden"; fi
  printf 'reload(%s __search)' "$EV_HOME/ev"
}

# 비주얼(인라인 이미지) ↔ 텍스트 미리보기 토글. 바인딩의 refresh-preview가 화면 갱신.
_ev_toggle_visual() {
  if [ "$(_ev_visual)" = 0 ]; then printf '1\n' > "$EV_STATE/visual"
  else printf '0\n' > "$EV_STATE/visual"; fi
}

# 추출 텍스트를 줄번호와 함께, 매칭 줄 강조해서 출력
_ev_preview_extracted() {   # 인자: file [line]
  local file="$1" line="${2:-}"
  if command -v bat >/dev/null 2>&1; then
    if [ -n "$line" ]; then
      ev_extract_text "$file" | bat --style=numbers --color=always --language=md --highlight-line "$line" 2>/dev/null
    else
      ev_extract_text "$file" | bat --style=numbers --color=always --language=md 2>/dev/null
    fi
  else
    ev_extract_text "$file" | cat -n
  fi
}

# 비주얼 미리보기: 성공 시 이미지 렌더(return 0). 불가하면 한 줄 힌트 출력 후 return 1
# (호출부가 텍스트 미리보기로 폴백한다).
_ev_preview_visual() {      # 인자: file
  local file="$1"
  if ! ev_graphics_supported; then
    printf '[hint] 이 터미널은 인라인 이미지를 지원하지 않습니다 (Ctrl-V로 텍스트 보기)\n\n'; return 1
  fi
  if [ -z "$(ev_visual_renderer)" ]; then
    printf '[hint] 비주얼 미리보기: brew install chafa\n\n'; return 1
  fi
  if ! command -v swiftc >/dev/null 2>&1; then
    printf '[hint] 비주얼 미리보기: Xcode CLT 필요 (xcode-select --install)\n\n'; return 1
  fi
  local thumbs="$EV_STATE/thumbs" png
  mkdir -p "$thumbs"
  png="$(ev_thumb_path "$file" "$thumbs")"
  if ! ev_make_thumb "$file" "$png"; then
    printf '[hint] 이 파일은 비주얼 미리보기를 생성할 수 없습니다\n\n'; return 1
  fi
  local cols="${FZF_PREVIEW_COLUMNS:-80}" lines="${FZF_PREVIEW_LINES:-40}"
  eval "$(ev_render_image_cmd "$png" "$cols" "$lines")" 2>/dev/null && return 0
  printf '[hint] 이미지 렌더 실패 (chafa)\n\n'; return 1
}

_ev_preview() {             # 인자: file [line]
  local file="$1" line="${2:-}"
  # 직전 미리보기에서 그린 인라인 이미지를 먼저 지운다(텍스트로 바뀔 때 잔상 방지).
  if ev_graphics_supported; then ev_clear_images; fi
  if [ "${EV_STATE:+x}" = x ] && [ -f "$EV_STATE/visual" ] && [ "$(_ev_visual)" = 1 ]; then
    _ev_preview_visual "$file" && return 0
  fi
  case "$file" in
    *.hwpx|*.HWPX|*.docx|*.DOCX|*.pptx|*.PPTX|*.xlsx|*.XLSX)
      _ev_preview_extracted "$file" "$line" ;;
    *.pdf|*.PDF)
      if command -v pdftotext >/dev/null 2>&1; then
        _ev_preview_extracted "$file" "$line"
      else
        ev_file_info "$file"; printf '\n[hint] PDF 본문 보기: brew install poppler\n'
      fi ;;
    *)
      if ev_is_text "$file"; then
        eval "$(ev_preview_cmd "$file" "$line")" 2>/dev/null || true
      else
        ev_file_info "$file"        # 바이너리는 bat 경고 대신 파일 정보
      fi
      ;;
  esac
}

_ev_open() {                # 인자: file [line]
  local file="$1" line="${2:-}"
  [ -z "$file" ] && return 0
  case "$file" in
    *.hwpx|*.HWPX)          # hwpx는 추출 텍스트를 pager로 (한글 앱 없이도 읽기)
      if [ "${EV_DRY_RUN:-0}" = 1 ]; then printf 'pager:%s\n' "$file"; return 0; fi
      ev_extract_text "$file" | less -R
      return 0
      ;;
  esac
  # 텍스트면 $EDITOR로 해당 줄에서, 아니면(pdf/이미지 등) macOS 기본 앱으로 연다.
  if ev_is_text "$file"; then
    local cmd
    cmd="$(ev_editor_cmd "${EDITOR:-vi}" "$file" "$line")"
    if [ "${EV_DRY_RUN:-0}" = 1 ]; then printf '%s\n' "$cmd"; return 0; fi
    eval "$cmd"
  else
    if [ "${EV_DRY_RUN:-0}" = 1 ]; then printf 'open %s\n' "$file"; return 0; fi
    open "$file"
  fi
}

# ── 비대화형 CLI (export / 파이프) ─────────────────────────
_ev_cli_list() {            # ev -l [DIR] [--format F|--json]
  local dir="." fmt="paths"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)   fmt="json" ;;
      --format) shift; fmt="${1:-paths}" ;;
      *)        dir="$1" ;;
    esac
    shift
  done
  { ev_fd_cmd "$dir" 0 | _ev_run_argv | ev_strip_ansi | ev_format "$fmt"; } || true
}

_ev_cli_grep() {            # ev -g QUERY [DIR] [--format F|--json]
  local q="" dir="." fmt="lines" gotq=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)   fmt="json" ;;
      --format) shift; fmt="${1:-lines}" ;;
      *)        if [ "$gotq" -eq 0 ]; then q="$1"; gotq=1; else dir="$1"; fi ;;
    esac
    shift
  done
  [ -z "$q" ] && { print -u2 "사용법: ev -g <검색어> [디렉터리] [--format F|--json]"; exit 1; }
  { ev_rg_cmd "$dir" 0 "$q" "$EV_EXTRACTOR" | _ev_run_argv | ev_strip_ansi | ev_format "$fmt"; } || true
}

_ev_cli_to_txt() {          # ev --to-txt DIR [OUTDIR]
  local dir="${1:-}" out="${2:-}"
  [ -z "$dir" ]   && { print -u2 "사용법: ev --to-txt <디렉터리> [출력디렉터리]"; exit 1; }
  [ -d "$dir" ]   || { print -u2 "디렉터리가 아닙니다: $dir"; exit 1; }
  out="${out:-$dir}"
  local count=0 f rel target
  while IFS= read -r f; do
    rel="${f#"$dir"/}"
    target="$out/$rel.txt"
    mkdir -p "$(dirname "$target")"
    ev_extract_text "$f" > "$target"
    print "[OK] $target"
    count=$((count + 1))
  done < <(fd -e hwpx -e docx . "$dir" 2>/dev/null)
  print "변환 완료: ${count}개"
}

# ── TUI export 액션 (선택분, 없으면 현재 항목 = fzf {+f}) ──
_ev_export_results() {      # arg: 선택 결과 라인이 담긴 파일 → Markdown 저장
  local listfile="$1" ts out n
  [ -f "$listfile" ] || { print "[ERR] 선택 없음"; return 0; }
  ts="$(date +%Y%m%d-%H%M%S)"
  out="$EV_EXPORT_DIR/ev-export-$ts.md"
  {
    printf '# ev export — %s\n\n' "$ts"
    ev_strip_ansi < "$listfile" | ev_export_md
  } > "$out"
  n="$(ev_strip_ansi < "$listfile" | grep -c .)"
  print "[OK] ${n}건 저장 → $out"
}

_ev_copy_paths() {          # arg: 선택 결과 라인 파일 → 경로만 클립보드
  local listfile="$1" paths n
  [ -f "$listfile" ] || { print "[ERR] 선택 없음"; return 0; }
  paths="$(ev_strip_ansi < "$listfile" | ev_export_paths)"
  printf '%s\n' "$paths" | eval "$EV_CLIP"
  n="$(printf '%s\n' "$paths" | grep -c .)"
  print "[OK] 경로 ${n}개 복사됨"
}

_ev_zip_files() {           # arg: 선택 결과 라인 파일 → 해당 파일들 zip
  local listfile="$1" ts out p
  [ -f "$listfile" ] || { print "[ERR] 선택 없음"; return 0; }
  local files=()
  while IFS= read -r p; do [ -n "$p" ] && files+=("$p"); done \
    < <(ev_strip_ansi < "$listfile" | ev_export_paths)
  [ "${#files[@]}" -eq 0 ] && { print "[ERR] 파일 없음"; return 0; }
  ts="$(date +%Y%m%d-%H%M%S)"
  out="$EV_EXPORT_DIR/ev-files-$ts.zip"
  zip -q "$out" "${files[@]}" 2>/dev/null
  print "[OK] ${#files[@]}개 → $out"
}

# ── 의존성 자동 설치 ─────────────────────────────────────────
_ev_ensure_deps() {
  local missing
  missing="$(ev_missing_deps rg fzf fd | tr '\n' ' ')"
  missing="${missing%% }"
  [ -z "$missing" ] && return 0

  if [ "${EV_AUTO_INSTALL:-1}" = 0 ]; then
    print -u2 "필수 도구 누락: $missing"
    print -u2 "설치: $(ev_install_cmd ${=missing})"
    exit 1
  fi
  if ! command -v brew >/dev/null 2>&1; then
    print -u2 "필수 도구 누락: $missing — Homebrew가 없어 자동 설치할 수 없습니다."
    print -u2 "먼저 Homebrew를 설치하세요: https://brew.sh"
    exit 1
  fi
  print -u2 "필수 도구 자동 설치: brew install $missing"
  if ! brew install ${=missing}; then
    print -u2 "설치 실패. 수동으로 시도하세요: $(ev_install_cmd ${=missing})"
    exit 1
  fi
}

# ── 메인 (대화형 fzf 실행) ──────────────────────────────────
_ev_main() {
  _ev_ensure_deps
  local root="${1:-.}"
  if [ ! -d "$root" ]; then
    print -u2 "디렉터리가 아닙니다: $root"
    exit 1
  fi
  export EV_ROOT="${root:A}"
  export EV_STATE="$(mktemp -d)"
  trap 'rm -rf "$EV_STATE"' EXIT
  _ev_init

  # 빈 화면은 파일 목록, 타이핑하면 fd(파일명)+rg(내용)를 합쳐 reload.
  # fzf 자체 필터는 끄고(--disabled) 검색은 fd/rg가 담당한다.
  local self="$EV_HOME/ev"
  : | fzf \
    --ansi --disabled --multi --prompt 'search> ' \
    --delimiter : \
    --preview "$self __preview {1} {2}" \
    --preview-window 'right,55%,border-left,+{2}/3' \
    --bind "start:reload($self __search)" \
    --bind "change:reload($self __search)" \
    --bind "ctrl-f:transform($self __cycle-scope)" \
    --bind "ctrl-h:transform($self __toggle-hidden)" \
    --bind "enter:become($self __open {1} {2})" \
    --bind "ctrl-o:execute-silent(open -R {1})" \
    --bind "ctrl-v:execute-silent($self __toggle-visual)+refresh-preview" \
    --bind 'tab:toggle+down' \
    --bind 'shift-tab:toggle+up' \
    --bind 'ctrl-a:toggle-all' \
    --bind "ctrl-e:transform-header($self __export-results {+f})" \
    --bind "ctrl-y:transform-header($self __copy-paths {+f})" \
    --bind "ctrl-g:transform-header($self __zip-files {+f})" \
    --bind '?:toggle-preview' \
    --bind 'esc:clear-query' \
    --header $'Ctrl-F 범위  Ctrl-H 숨김  Ctrl-V 비주얼  Enter 열기  Ctrl-O Finder  Esc 지움  Ctrl-C 종료\nTab 선택  Ctrl-A 전체  Ctrl-E 내보내기(md)  Ctrl-Y 복사  Ctrl-G zip'
}

_ev_help() {
  cat <<'EOF'
ev — 터미널 즉시 파일 검색 (파일명 + 내용, hwpx/docx 포함)

대화형:
  ev [디렉터리]              현재(또는 지정) 폴더에서 TUI 검색

비대화형 (export / 파이프):
  ev -l|--list [디렉터리]            파일 목록 출력
  ev -g|--grep <검색어> [디렉터리]   내용 검색 출력 (hwpx/docx 포함)
  ev -x|--extract <파일>             파일 평문 추출 출력
  ev --to-txt <디렉터리> [출력]      폴더 내 hwpx/docx 일괄 .txt 변환

  --format paths|lines|md|csv|json   출력 포맷 (-l 기본 paths, -g 기본 lines)
  --json                             --format json 과 동일

예:
  ev -l ~/work --format json | jq .
  ev -g 유동성 ~/docs --format md > report.md
  ev -x report.hwpx | less
EOF
}

# ── 디스패치 ─────────────────────────────────────────────────
case "${1:-}" in
  __init)          shift; _ev_init "$@" ;;
  __search)        _ev_search ;;
  __cycle-scope)   _ev_cycle_scope ;;
  __toggle-hidden) _ev_toggle_hidden ;;
  __toggle-visual) _ev_toggle_visual ;;
  __preview)        shift; _ev_preview "$@" ;;
  __open)           shift; _ev_open "$@" ;;
  __export-results) shift; _ev_export_results "$@" ;;
  __copy-paths)     shift; _ev_copy_paths "$@" ;;
  __zip-files)      shift; _ev_zip_files "$@" ;;
  -l|--list)       shift; _ev_cli_list "$@" ;;
  -g|--grep)       shift; _ev_cli_grep "$@" ;;
  -x|--extract)    shift; ev_extract_text "${1:?사용법: ev -x <파일>}" ;;
  --to-txt)        shift; _ev_cli_to_txt "$@" ;;
  -h|--help)       _ev_help ;;
  *)               _ev_main "$@" ;;
esac
